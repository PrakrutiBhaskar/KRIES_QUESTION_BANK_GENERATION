# --- Groq API ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
# llama-3.3-70b-versatile was deprecated by Groq; openai/gpt-oss-120b is the
# current recommended replacement. Check https://console.groq.com/docs/models
# if this ever starts failing with model_decommissioned.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_TEMPERATURE=0.7
GROQ_MAX_RETRIES=3
GROQ_RETRY_BACKOFF_SECONDS=1.0
# Client-side tokens-per-minute throttle, matching the free/on_demand tier.
# Raise this after upgrading to Dev Tier. 0 disables proactive throttling.
GROQ_TPM_LIMIT=8000
GROQ_ESTIMATED_OUTPUT_TOKENS=900

# --- Generation / validation ---
MAX_REGENERATION_RETRIES=2
NEAR_DUPLICATE_SIMILARITY_THRESHOLD=0.90
MAX_BATCH_COUNT=25
ENABLE_LLM_RELEVANCE_CHECK=false

# --- Backend (Module B) ---
DATABASE_URL=postgresql://localhost:5432/question_bank_db
