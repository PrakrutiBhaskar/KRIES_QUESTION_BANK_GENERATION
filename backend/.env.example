# --- Backend (Module B) ---

# EASIEST for local development — no database server needed. The file is
# created and the tables are built automatically on first start:
DATABASE_URL=sqlite+aiosqlite:///./question_bank.db

# PostgreSQL (production). Note the +asyncpg driver — a bare postgresql:// URL
# will not work. Run `alembic upgrade head` first, or set AUTO_CREATE_TABLES=true.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/question_bank_db
# AUTO_CREATE_TABLES=false
DB_ECHO=false
DEBUG=false

# Comma-separated. Lock this down to the deployed frontend origin in production.
CORS_ORIGINS=*

# Serve a repeated identical /generate request from stored questions instead of
# calling Groq again. Clients can override per-request with {"refresh": true}.
ENABLE_GENERATION_CACHE=true

# --- Auth ---
# Signing key for access tokens (HS256). REQUIRED in production. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty, a random key is generated per process (tokens die on restart).
JWT_SECRET=
# Token lifetime in minutes (default: 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Password reset ---
# Reset links expire after this many minutes and work once.
PASSWORD_RESET_EXPIRE_MINUTES=30
# The frontend's origin: reset links point at FRONTEND_URL/reset-password?token=...
FRONTEND_URL=http://localhost:5173
# Outgoing email. Leave SMTP_HOST empty in development: the reset link is then
# printed in the backend log instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="KRIES <no-reply@yourdomain.com>"
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls

# --- Answer-key verification ---
# Rule checks (Maths/Science): free and exact. Leave on.
ENABLE_ANSWER_RULE_CHECKS=true
# Independent second AI pass: one Groq call per chunk of questions, made only
# when "Verify answers" is clicked (never during generation). Set false to save
# Groq quota / time.
ENABLE_LLM_ANSWER_VERIFICATION=true
# Optional: a different Groq model for the second opinion (empty = same model).
VERIFIER_MODEL=
VERIFICATION_CHUNK_SIZE=10

# --- Rate limiting ---
# Each limit is "<requests>/<seconds>". Counters live in this process's memory:
# fine for one worker/instance; use a shared store (Redis) before running several.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/60      # every request, per signed-in user (per IP if anonymous)
RATE_LIMIT_LOGIN=10/60         # POST /auth/login, per IP
RATE_LIMIT_SIGNUP=5/3600       # POST /auth/signup, per IP
RATE_LIMIT_PASSWORD_RESET=5/900  # POST /auth/forgot-password + /auth/reset-password, per IP
RATE_LIMIT_GENERATE=30/60      # POST /generate + /practice/sessions (they call the LLM), per user
RATE_LIMIT_EXPORT=10/60        # POST /export/{id}, per user
RATE_LIMIT_UPLOAD=20/60        # POST /figures (image uploads), per user
LOGIN_MAX_FAILURES=5/900       # wrong passwords per (IP, email) before a 15-minute lockout
# Set to true ONLY behind a reverse proxy you control (Render, Nginx): it makes
# the limits use X-Forwarded-For. Otherwise clients could fake their IP.
TRUST_PROXY_HEADERS=false

# --- Figures (diagrams attached to questions and answer keys) ---
# Where uploaded figures are stored, and the largest upload accepted (bytes).
FIGURE_DIR=./var/figures
MAX_FIGURE_BYTES=5242880
# Most figures described to the model in one "generate with figures" request.
MAX_GENERATION_FIGURES=6

# --- Export ---
EXPORT_DIR=./var/exports
# Used to build the absolute download_url returned by POST /export/{paper_id}.
PUBLIC_BASE_URL=http://localhost:8000
# auto | weasyprint | reportlab | fpdf. Kannada papers need weasyprint or fpdf.
PDF_RENDERER=auto

# --- Syllabus (optional, but recommended) ---
# Points at the chapter JSON (generation_engine.syllabus.SyllabusIndex shape).
# When set: (1) unknown chapters are rejected with a 400 instead of being
# created on the fly, and (2) subjects/chapters from this file are seeded
# into the DB at startup, so GET /subjects/{subject}/chapters isn't empty
# before anyone's generated a question yet. data/syllabus.json ships an
# interim, manually-curated chapter list (see data/README.md) — swap it out
# once the real PDF-parsing pipeline lands.
# Relative paths are resolved against the working directory, then backend/, then the
# repo root, so this works whether uvicorn is started from backend/ or the repo root.
SYLLABUS_JSON_PATH=./data/syllabus.json

# --- Practice mode ---
# Generate on demand when a chapter has too few stored questions for a session.
PRACTICE_GENERATE_SHORTFALL=true

# --- Module A (generation) settings ---
# GROQ_API_KEY can go in either the repo-root .env or this file.
# GROQ_API_KEY=...

# --- Textbook grounding (strict Karnataka State Board mode) ---
# Folder of corpus JSON written by scripts/ingest_textbooks.py from the KTBS PDFs.
TEXTBOOKS_DIR=./data/textbooks
# true: generate ONLY for (subject, grade) pairs that have an ingested textbook,
# with chapters taken from the textbook itself (syllabus.json is ignored).
# Set true only after ingesting textbooks (otherwise every request is refused).
REQUIRE_TEXTBOOK=false
MAX_PASSAGE_CHARS=900
# Min share of a question's key terms that must appear in its source passage.
GROUNDING_MIN_OVERLAP=0.30
