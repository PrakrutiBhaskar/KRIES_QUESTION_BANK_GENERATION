# --- Backend (Module B) ---

# EASIEST for local development — no database server needed. The file is
# created and the tables are built automatically on first start:
DATABASE_URL=sqlite+aiosqlite:///./question_bank.db

# PostgreSQL (production). Note the +asyncpg driver — a bare postgresql:// URL
# will not work. Run `alembic upgrade head` first, or set AUTO_CREATE_TABLES=true.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/question_bank_db
# AUTO_CREATE_TABLES=false
DB_ECHO=false
DEBUG=false

# Comma-separated. Lock this down to the deployed frontend origin in production.
CORS_ORIGINS=*

# Serve a repeated identical /generate request from stored questions instead of
# calling Groq again. Clients can override per-request with {"refresh": true}.
ENABLE_GENERATION_CACHE=true

# --- Auth ---
# Signing key for access tokens (HS256). REQUIRED in production. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty, a random key is generated per process (tokens die on restart).
JWT_SECRET=
# Token lifetime in minutes (default: 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Export ---
EXPORT_DIR=./var/exports
# Used to build the absolute download_url returned by POST /export/{paper_id}.
PUBLIC_BASE_URL=http://localhost:8000
# auto | weasyprint | reportlab | fpdf. Kannada papers need weasyprint or fpdf.
PDF_RENDERER=auto

# --- Syllabus (optional, but recommended) ---
# Points at the chapter JSON (generation_engine.syllabus.SyllabusIndex shape).
# When set: (1) unknown chapters are rejected with a 400 instead of being
# created on the fly, and (2) subjects/chapters from this file are seeded
# into the DB at startup, so GET /subjects/{subject}/chapters isn't empty
# before anyone's generated a question yet. data/syllabus.json ships an
# interim, manually-curated chapter list (see data/README.md) — swap it out
# once the real PDF-parsing pipeline lands.
# Relative paths are resolved against the working directory, then backend/, then the
# repo root, so this works whether uvicorn is started from backend/ or the repo root.
SYLLABUS_JSON_PATH=./data/syllabus.json

# --- Practice mode ---
# Generate on demand when a chapter has too few stored questions for a session.
PRACTICE_GENERATE_SHORTFALL=true

# --- Module A (generation) settings ---
# GROQ_API_KEY can go in either the repo-root .env or this file.
# GROQ_API_KEY=...
