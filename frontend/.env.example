# Base URL of the FastAPI API (including the /api/v1 prefix).
# Leave as-is in dev: Vite proxies /api to VITE_BACKEND_URL.
# For a production build served from a different origin, set the full URL,
# e.g. https://api.example.com/api/v1 (and add your site to CORS_ORIGINS on the backend).
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api requests (dev only).
VITE_BACKEND_URL=http://localhost:8000
